FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Optional: also cross-post everything to a Facebook Group. Needs a USER
# access token (not a Page token) with the publish_to_groups permission,
# and the app must be added to the group via Group Settings > Apps.
# Leave both blank to skip group posting entirely.
FB_GROUP_ID=
FB_GROUP_ACCESS_TOKEN=

# Set to 1 to only scrape and print the caption/image locally without posting to Facebook
DRY_RUN=0
